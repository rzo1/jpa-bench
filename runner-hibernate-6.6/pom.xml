<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rzo1.jpabench</groupId>
        <artifactId>jpa-bench</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>runner-hibernate-6.6</artifactId>
    <name>jpa-bench :: runner-hibernate-6.6</name>
    <description>Benchmark runner for Hibernate ORM 6.6 (Jakarta Persistence 3.1).</description>

    <properties>
        <hibernate.version>${hibernate6.version}</hibernate.version>
        <!-- written into bench-provider.properties; the "enhance" profile switches it -->
        <bench.enhancement>none</bench.enhancement>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>bench-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>bench-model</artifactId>
        </dependency>
        <!-- exactly one provider; it brings its own jakarta.persistence-api (3.1) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- optional build-time enhancement (-Penhance): lazy initialization and dirty tracking -->
        <profile>
            <id>enhance</id>
            <properties>
                <bench.enhancement>build-time (lazy initialization, dirty tracking)</bench.enhancement>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-model</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>unpack-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeArtifactIds>bench-model</includeArtifactIds>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <excludes>META-INF/**</excludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- renamed to hibernate-maven-plugin in Hibernate 7 -->
                    <plugin>
                        <groupId>org.hibernate.orm.tooling</groupId>
                        <artifactId>hibernate-enhance-maven-plugin</artifactId>
                        <version>${hibernate.version}</version>
                        <executions>
                            <execution>
                                <id>enhance-model</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>enhance</goal>
                                </goals>
                                <configuration>
                                    <enableLazyInitialization>true</enableLazyInitialization>
                                    <enableDirtyTracking>true</enableDirtyTracking>
                                    <enableAssociationManagement>false</enableAssociationManagement>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>benchmarks-jar</id>
                                <configuration>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>${project.groupId}:bench-model</exclude>
                                        </excludes>
                                    </artifactSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
