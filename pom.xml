<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.rzo1.jpabench</groupId>
    <artifactId>jpa-bench</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jpa-bench</name>
    <description>A fair, reproducible JMH benchmark comparing Jakarta Persistence providers.</description>
    <url>https://github.com/rzo1/jpa-bench</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <modules>
        <module>bench-model</module>
        <module>bench-data</module>
        <module>bench-core</module>
        <module>runner-openjpa-4.1</module>
        <module>runner-openjpa-4.2</module>
        <module>runner-openjpa-4.1-agent</module>
        <module>runner-openjpa-4.2-agent</module>
        <module>runner-hibernate-6.6</module>
        <module>runner-hibernate-7</module>
        <module>runner-eclipselink-4</module>
        <module>runner-eclipselink-5</module>
        <module>runner-eclipselink-4-woven</module>
        <module>runner-eclipselink-5-woven</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- The entity model and the benchmarks are compiled against JPA 3.1 only (provided scope).
             The version is deliberately NOT in dependencyManagement: every runner gets the API version
             its provider depends on. -->
        <jakarta.persistence-api.version>3.1.0</jakarta.persistence-api.version>

        <jmh.version>1.37</jmh.version>
        <h2.version>2.5.252</h2.version>
        <postgresql.version>42.7.14</postgresql.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <datasource-proxy.version>1.11.1</datasource-proxy.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <slf4j.version>2.0.20</slf4j.version>
        <junit.version>6.1.3</junit.version>

        <!-- EclipseLink versions, shared by the unwoven and the woven runner of each line.
             5.0.3 is not released yet (Maven Central only has 5.0.3-RC1): latest final 5.0.x -->
        <eclipselink4.version>4.0.10</eclipselink4.version>
        <eclipselink5.version>5.0.2</eclipselink5.version>

        <!-- Static weaving (EclipseLink): the executions in pluginManagement below are bound to this phase;
             "none" switches them off. The weave profile of runner-eclipselink-* and the *-woven runners set
             process-classes. -->
        <bench.weave.phase>none</bench.weave.phase>
        <!-- artifact left out of benchmarks.jar; runners whose model classes live in target/classes (enhanced or
             woven) set ${project.groupId}:bench-model -->
        <bench.shade.excludeModel>${project.groupId}:bench-model-is-included</bench.shade.excludeModel>
        <!-- model classes in a runner's target/classes are always removed at the start of a build (see the
             remove-stale-model execution); bench-model itself sets true -->
        <bench.removeStaleModel.skip>false</bench.removeStaleModel.skip>

        <!-- Database settings shared by all runners. The single place of the PostgreSQL image: pinned by the
             digest of the multi-platform image index, because a tag can be re-pushed with a new base image.
             Filtered into bench-core's bench-build.properties, read by DatabaseServer and recorded by run.sh. -->
        <postgres.image>postgres:18.1@sha256:1090bc3a8ccfb0b55f78a494d76f8d603434f7e4553543d6e807bc7bd6bbd17f</postgres.image>

        <exec-maven-plugin.version>3.5.1</exec-maven-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bench-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bench-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>bench-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ttddyy</groupId>
                <artifactId>datasource-proxy</artifactId>
                <version>${datasource-proxy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                    <executions>
                        <!-- EclipseLink static weaving, step 1 (bound to ${bench.weave.phase}): the unwoven model
                             classes and bench-core's persistence.xml -->
                        <execution>
                            <id>weave-unpack-model</id>
                            <phase>${bench.weave.phase}</phase>
                            <goals>
                                <goal>unpack-dependencies</goal>
                            </goals>
                            <configuration>
                                <includeArtifactIds>bench-model</includeArtifactIds>
                                <outputDirectory>${project.build.directory}/unwoven</outputDirectory>
                                <excludes>META-INF/**</excludes>
                                <overWriteReleases>true</overWriteReleases>
                                <overWriteSnapshots>true</overWriteSnapshots>
                            </configuration>
                        </execution>
                        <execution>
                            <id>weave-unpack-persistence-xml</id>
                            <phase>${bench.weave.phase}</phase>
                            <goals>
                                <goal>unpack-dependencies</goal>
                            </goals>
                            <configuration>
                                <includeArtifactIds>bench-core</includeArtifactIds>
                                <outputDirectory>${project.build.directory}/persistence-info</outputDirectory>
                                <includes>META-INF/persistence.xml</includes>
                                <overWriteReleases>true</overWriteReleases>
                                <overWriteSnapshots>true</overWriteSnapshots>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!-- EclipseLink static weaving, step 2: StaticWeave writes the woven classes into target/classes -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>weave-model</id>
                            <phase>${bench.weave.phase}</phase>
                            <goals>
                                <goal>java</goal>
                            </goals>
                            <configuration>
                                <mainClass>org.eclipse.persistence.tools.weaving.jpa.StaticWeave</mainClass>
                                <classpathScope>compile</classpathScope>
                                <arguments>
                                    <argument>-persistenceinfo</argument>
                                    <argument>${project.build.directory}/persistence-info</argument>
                                    <argument>-loglevel</argument>
                                    <argument>WARNING</argument>
                                    <argument>${project.build.directory}/unwoven</argument>
                                    <argument>${project.build.outputDirectory}</argument>
                                </arguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <configuration>
                        <!-- filtered resources use @property@ so that ${...} placeholders of the
                             bench-*.properties files are left for ProviderSettings -->
                        <useDefaultDelimiters>false</useDefaultDelimiters>
                        <delimiters>
                            <delimiter>@</delimiter>
                        </delimiters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <!-- Every runner builds target/benchmarks.jar with exactly this configuration.
                     A runner only declares the plugin (groupId/artifactId) in its own pom. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>benchmarks-jar</id>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <finalName>benchmarks</finalName>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <artifactSet>
                                    <excludes>
                                        <exclude>${bench.shade.excludeModel}</exclude>
                                    </excludes>
                                </artifactSet>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>org.openjdk.jmh.Main</mainClass>
                                        <manifestEntries>
                                            <Multi-Release>true</Multi-Release>
                                        </manifestEntries>
                                    </transformer>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                        <resource>META-INF/BenchmarkList</resource>
                                    </transformer>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                        <resource>META-INF/CompilerHints</resource>
                                    </transformer>
                                </transformers>
                                <filters>
                                    <filter>
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                            <exclude>META-INF/MANIFEST.MF</exclude>
                                            <exclude>module-info.class</exclude>
                                            <exclude>META-INF/versions/*/module-info.class</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
              Enhanced or woven model classes of an earlier build (-Penhance, -Pweave) must never end up in a
              later build without that profile: target/classes would still contain them, the shaded jar would
              prefer them over the bench-model jar, and the recorded enhancement mode would be wrong. So every
              build of a runner starts without model classes in target/classes; enhancing builds unpack fresh ones.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-model</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <skip>${bench.removeStaleModel.skip}</skip>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}/io/github/rzo1/jpabench/model</directory>
                                </fileset>
                                <fileset>
                                    <directory>${project.build.directory}/unwoven</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
