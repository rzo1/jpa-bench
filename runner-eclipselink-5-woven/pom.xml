<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rzo1.jpabench</groupId>
        <artifactId>jpa-bench</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- runner-eclipselink-5 with static weaving, so that woven and unwoven EclipseLink run side by side -->
    <artifactId>runner-eclipselink-5-woven</artifactId>
    <name>jpa-bench :: runner-eclipselink-5-woven</name>
    <description>Benchmark runner for EclipseLink 5 with static weaving at build time.</description>

    <properties>
        <eclipselink.version>${eclipselink5.version}</eclipselink.version>
        <!-- written into bench-provider.properties -->
        <bench.enhancement>static weaving (build time)</bench.enhancement>
        <bench.weaving>static</bench.weaving>
        <!-- enable the parent's static weaving executions and shade the woven classes -->
        <bench.weave.phase>process-classes</bench.weave.phase>
        <bench.shade.excludeModel>${project.groupId}:bench-model</bench.shade.excludeModel>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>bench-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>bench-model</artifactId>
        </dependency>
        <!-- exactly one provider; it brings its own jakarta.persistence-api (3.2) -->
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>org.eclipse.persistence.jpa</artifactId>
            <version>${eclipselink.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- settings of runner-eclipselink-5, filtered with this module's properties -->
            <resource>
                <directory>${project.basedir}/../runner-eclipselink-5/src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
