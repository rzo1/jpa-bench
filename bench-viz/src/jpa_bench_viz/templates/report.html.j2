<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>jpa-bench: {{ run.machine }}, {{ run.date or directory.name }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<main>
{% if links %}<p class="crumbs"><a href="{{ links.index }}">All runs</a> · <a href="{{ links.datasets }}">Data model and datasets</a></p>{% endif %}
<h1>jpa-bench: {{ run.machine }}, {{ run.date or directory.name }}</h1>
<p class="lede">
  JPA providers on identical schema, data and settings. Run <code>{{ run.run_id }}</code>.
  Scores are JMH scores (mean ± 99.9% confidence half-width); statement metrics are per operation.
</p>

{% include "_summary.html.j2" %}

<nav class="card" aria-label="Contents">
  <strong>Contents</strong>
  <ul>
    <li><a href="#summary">Summary</a></li>
    <li><a href="#providers">Providers</a></li>
    <li><a href="#settings">Settings</a></li>
    {% if verification %}<li><a href="#verification">Result verification</a></li>{% endif %}
    {% for s in sections %}
    <li><a href="#{{ s.anchor }}">{{ s.title }}</a></li>
    {% endfor %}
  </ul>
</nav>

<h2 id="settings">Settings</h2>
{% if metadata %}
<dl class="meta card">
  <div><dt>Docker</dt><dd>{{ metadata.docker }}</dd></div>
  {% if metadata.metering %}<div><dt>Statement metering</dt><dd>{% if metadata.metering.mode == "separate" %}separate metered run ({{ metadata.metering.forks }} fork, {{ metadata.metering.warmupIterations }} + {{ metadata.metering.iterations }} × {{ metadata.metering.time }}); times are unmetered{% elif metadata.metering.mode == "inline" %}inline: times include the metering overhead{% else %}off{% endif %}</dd></div>{% endif %}
  {% if metadata.order %}<div><dt>Order</dt><dd>{{ metadata.order.mode }}{% if metadata.order.seed %} (seed {{ metadata.order.seed }}){% endif %}</dd></div>{% endif %}
  {% if metadata.build %}<div><dt>Build profiles</dt><dd>{{ metadata.build.profiles or "none" }}</dd></div>{% endif %}
  <div><dt>Benchmarks</dt><dd><code>{{ metadata.matrix.include }}</code></dd></div>
  {% set first = (metadata.runners or {}).values() | list | first %}
  {% if first %}<div><dt>Data seed</dt><dd>{{ first.seed }}</dd></div>{% endif %}
</dl>
{% else %}
<p class="note">No metadata.json in this directory.</p>
{% endif %}

{% for p in providers %}
<details>
  <summary>Settings of {{ p.label }}</summary>
  <div class="scroll"><table>
    <tbody>
    {% for k, v in p.properties | dictsort %}<tr><td><code>{{ k }}</code></td><td class="text"><code>{{ v }}</code></td></tr>{% endfor %}
    {% for k, v in p.harness | dictsort %}<tr><td><code>{{ k }}</code></td><td class="text"><code>{{ v }}</code></td></tr>{% endfor %}
    </tbody>
  </table></div>
</details>
{% endfor %}

{% if verification %}
<h2 id="verification">Result verification</h2>
{% if verification.mismatches %}
<p class="mismatch">{{ verification.mismatches }} operation(s) return different results for different providers; their scores are not comparable.</p>
{% else %}
<p class="note">Every read operation returned the same result checksum for every provider (fixed inputs, run once per trial before measuring).</p>
{% endif %}
<details class="card">
  <summary>Checksums per operation</summary>
  <div class="scroll">
  <table>
    <thead><tr><th class="text">Database, dataset</th><th class="text">Operation</th>{% for r in verification.runners %}<th>{{ labels[r] if r in labels else r }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in verification.rows %}
    <tr{% if row.mismatch %} class="mismatch"{% endif %}><td class="text">{{ row.scope }}</td><td class="text">{{ row.operation }}</td>{% for c in row.checksums %}<td><code>{{ c }}</code></td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</details>
{% endif %}

{% macro bars(chart) %}
<h4>{{ chart.title }} <span class="note">({{ chart.unit }}, {{ chart.better }})</span></h4>
<div class="bars" role="list">
  {% for r in chart.rows %}
  {% if r.sql %}<a class="name" href="#{{ r.sql }}" role="listitem">{% else %}<span class="name" role="listitem">{% endif %}<span class="swatch {{ r.css }}" aria-hidden="true"></span>{{ r.label }}{% if r.sql %}</a>{% else %}</span>{% endif %}
  <div class="track {{ r.css }}" title="{{ r.label }}: {{ r.score }} ± {{ r.error }} {{ chart.unit }}" aria-hidden="true">
    <div class="fill" style="width: {{ '%.2f' | format(r.width) }}%"></div>
    {% if r.err_width > 0 %}<div class="errbar" style="left: {{ '%.2f' | format(r.err_left) }}%; width: {{ '%.2f' | format(r.err_width) }}%"></div>{% endif %}
  </div>
  <span class="val">{% if r.best %}<strong>{{ r.score | num }}</strong>{% else %}{{ r.score | num }}{% endif %} <span class="err">± {{ r.error | num }}</span><span class="rel">{% if r.best %}fastest{% elif r.tie %}≈ {{ r.factor | factor }}{% else %}{{ r.factor | factor }}{% endif %}</span></span>
  {% endfor %}
</div>
{% endmacro %}

{% for s in sections %}
<h2 id="{{ s.anchor }}">{{ s.title }}</h2>

{% if s.single %}
{% set b = s.benchmarks[0] %}
<div class="card" id="{{ b.anchor }}">
  {% for chart in b.bars %}{{ bars(chart) }}{% endfor %}
  <p class="legend">Bar: score, line: ± error; number: factor to the fastest, ≈: within error of the fastest.</p>
</div>
{% else %}
{% for t in s.score_tables %}
<h3>{{ t.title }}: factor to the fastest <span class="note">({{ t.unit }}, {{ t.better }})</span></h3>
<p class="legend">1.00 = fastest (bold frame); ≈ and thin frame: score ± error overlaps the fastest; colour steps at 0.95, 0.8, 0.6, 0.4 and 0.2.</p>
<div class="scroll card">
<table class="heat">
  <thead><tr><th>Benchmark</th>{% for r in t.runners %}<th class="runner"><span class="swatch {{ classes[r] }}" aria-hidden="true"></span>{{ labels[r] }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for row in t.rows %}
  <tr>
    <td><a href="#{{ row.anchor }}">{{ row.benchmark }}</a></td>
    {% for cell in row.cells %}
    {% if cell %}
    <td class="cell heat-{{ cell.level }}{{ ' best' if cell.best }}{{ ' tie' if cell.tie }}" title="{{ labels[t.runners[loop.index0]] }}: {{ cell.score }} ± {{ cell.error }} {{ t.unit }}">{% if cell.tie %}≈ {% endif %}{{ cell.relative | factor }}</td>
    {% else %}<td class="cell err">n/a</td>{% endif %}
    {% endfor %}
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endfor %}
{% endif %}

<details>
  <summary>Scores ({{ s.score_tables | map(attribute='title') | join(', ') }})</summary>
  {% for t in s.score_tables %}
  <h3>{{ t.title }} <span class="note">({{ t.unit }}, {{ t.better }})</span></h3>
  <p class="legend">Score ± error, factor to the fastest below. Bold frame: fastest; thin frame and ≈: within error of the fastest.</p>
  <div class="scroll card">
  <table>
    <thead><tr><th>Benchmark</th>{% for r in t.runners %}<th>{{ labels[r] }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in t.rows %}
    <tr>
      <td>{{ row.benchmark }}</td>
      {% for cell in row.cells %}
      {% if cell %}
      <td class="{{ 'best' if cell.best }}{{ 'tie' if cell.tie }}">{{ cell.score | num }} <span class="err">± {{ cell.error | num }}</span><br><span class="rel">{% if cell.tie %}≈ {% endif %}{{ cell.relative | factor }}</span></td>
      {% else %}<td class="err">n/a</td>{% endif %}
      {% endfor %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endfor %}
</details>

{% if s.statements %}
<h3>Statements per operation</h3>
<p class="legend">
  Stacked by kind:
  <span class="swatch kind-select" aria-hidden="true"></span>SELECT
  <span class="swatch kind-insert" aria-hidden="true"></span>INSERT
  <span class="swatch kind-update" aria-hidden="true"></span>UPDATE
  <span class="swatch kind-delete" aria-hidden="true"></span>DELETE
  <span class="swatch kind-other" aria-hidden="true"></span>other.
  Numbers: statements, JDBC executions, batches, SQL characters per operation.
</p>
<div class="grid">
{% for c in s.statements %}
<div class="card">
  <h4>{{ c.benchmark }}</h4>
  <div class="bars stmts" role="list">
    {% for r in c.rows %}
    <span class="name" role="listitem"><span class="swatch {{ r.css }}" aria-hidden="true"></span>{{ r.label }}</span>
    <div class="stack" aria-hidden="true">
      {% for seg in r.segments %}<span class="{{ seg.css }}" style="width: {{ '%.2f' | format(seg.width) }}%" title="{{ seg.kind }}: {{ seg.value | num }}"></span>{% endfor %}
    </div>
    <span class="val" title="{% for seg in r.segments %}{{ seg.kind }} {{ seg.value | qty }}{% if not loop.last %}, {% endif %}{% endfor %}">{{ r.total | qty }} stmts<br><span class="err">{{ r.executions | qty }} exec · {{ r.batches | qty }} batches · {{ r.chars | count }} chars</span></span>
    {% endfor %}
  </div>
</div>
{% endfor %}
</div>
{% endif %}
{% if s.statement_rows %}
<details>
  <summary>Statement metrics table</summary>
  <div class="scroll card"><table>
    <thead><tr><th>Benchmark</th><th class="text">Provider</th>{% for c, label in statement_columns %}<th>{{ label }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in s.statement_rows %}
    <tr><td>{{ row.benchmark }}</td><td class="text">{{ labels[row.runner] }}</td>{% for c, label in statement_columns %}<td>{{ row["values"][c] | num }}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
  </table></div>
</details>
{% endif %}

{% set listed = s.benchmarks | selectattr("sql") | list if s.single else s.benchmarks %}
{% if listed %}
<h3>Per benchmark</h3>
{% endif %}
{% for b in listed %}
<details id="{{ b.anchor if not s.single else b.anchor ~ '-sql' }}">
  <summary>{{ b.name }}</summary>
  {% if not s.single %}{% for chart in b.bars %}{{ bars(chart) }}{% endfor %}{% endif %}
  {% for q in b.sql %}
  <div id="{{ q.anchor }}"><strong>{{ q.label }}</strong>: distinct SQL of the first iteration</div>
  <pre class="sql">{{ q.text }}</pre>
  {% endfor %}
</details>
{% endfor %}
{% endfor %}
</main>
</body>
</html>
