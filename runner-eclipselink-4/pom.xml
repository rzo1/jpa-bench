<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rzo1.jpabench</groupId>
        <artifactId>jpa-bench</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>runner-eclipselink-4</artifactId>
    <name>jpa-bench :: runner-eclipselink-4</name>
    <description>Benchmark runner for EclipseLink 4.0 (Jakarta Persistence 3.1).</description>

    <properties>
        <eclipselink.version>${eclipselink4.version}</eclipselink.version>
        <!-- written into bench-provider.properties; the "weave" profile switches both -->
        <bench.enhancement>none</bench.enhancement>
        <bench.weaving>false</bench.weaving>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>bench-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>bench-model</artifactId>
        </dependency>
        <!-- exactly one provider; it brings its own jakarta.persistence-api (3.1) -->
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>org.eclipse.persistence.jpa</artifactId>
            <version>${eclipselink.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- static weaving executions of the parent, disabled unless -Pweave -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- optional static weaving at build time (-Pweave), the same build as runner-eclipselink-4-woven -->
        <profile>
            <id>weave</id>
            <properties>
                <bench.enhancement>static weaving (build time)</bench.enhancement>
                <bench.weaving>static</bench.weaving>
                <bench.weave.phase>process-classes</bench.weave.phase>
                <bench.shade.excludeModel>${project.groupId}:bench-model</bench.shade.excludeModel>
            </properties>
        </profile>
    </profiles>
</project>
